    }
}

class SavingsAccount extends Account
{
    SavingsAccount(double balance)
    {
        super(balance);
    }

    void deposit(double amount)
    {
        if (amount > 0)
        {
            balance = balance + amount;
            System.out.println("Deposited: " + amount);
        }
        else
        {
            System.out.println("Invalid amount");
        }
    }
}

public class BankInheritance
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter opening balance: ");
        double bal = Double.parseDouble(sc.nextLine().trim());

        SavingsAccount sa = new SavingsAccount(bal);
        sa.checkBalance();

        System.out.print("Enter amount to deposit: ");
        double amt = Double.parseDouble(sc.nextLine().trim());
        sa.deposit(amt);

        sa.checkBalance();
        sc.close();
    }
}


// ==================================================
// Q4. SALARY OF PERMANENT AND CONTRACT EMPLOYEES (Employee superclass)
// File: EmployeeDemo.java
// ==================================================
import java.util.Scanner;

class Employee
{
    int empId;
    String name;

    Employee(int empId, String name)
    {
        this.empId = empId;
        this.name = name;
    }

    double calculateSalary()
    {
        return 0;
    }

    void display()
    {
        System.out.println("Employee ID   : " + empId);
        System.out.println("Employee Name : " + name);
        System.out.println("Salary        : " + calculateSalary());
    }
}

class PermanentEmployee extends Employee
{
    double basic;

    PermanentEmployee(int empId, String name, double basic)
    {
        super(empId, name);
        this.basic = basic;
    }

    @Override
    double calculateSalary()
    {
        double hra = 0.20 * basic;
        double da = 0.10 * basic;
        double pf = 0.12 * basic;
        return basic + hra + da - pf;
    }
}

class ContractEmployee extends Employee
{
    int daysWorked;
    double perDayWage;

    ContractEmployee(int empId, String name, int daysWorked, double perDayWage)
    {
        super(empId, name);
        this.daysWorked = daysWorked;
        this.perDayWage = perDayWage;
    }

    @Override
    double calculateSalary()
    {
        return daysWorked * perDayWage;
    }
}

public class EmployeeDemo
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        System.out.println("--- Permanent Employee ---");
        System.out.print("Enter employee id: ");
        int id1 = Integer.parseInt(sc.nextLine().trim());
        System.out.print("Enter name: ");
        String n1 = sc.nextLine();
        System.out.print("Enter basic salary: ");
        double basic = Double.parseDouble(sc.nextLine().trim());
        Employee e1 = new PermanentEmployee(id1, n1, basic);

        System.out.println("\n--- Contract Employee ---");
        System.out.print("Enter employee id: ");
        int id2 = Integer.parseInt(sc.nextLine().trim());
        System.out.print("Enter name: ");
        String n2 = sc.nextLine();
        System.out.print("Enter days worked: ");
        int days = Integer.parseInt(sc.nextLine().trim());
        System.out.print("Enter per day wage: ");
        double wage = Double.parseDouble(sc.nextLine().trim());
        Employee e2 = new ContractEmployee(id2, n2, days, wage);

        System.out.println("\n--- Permanent Employee Details ---");
        e1.display();
        System.out.println("\n--- Contract Employee Details ---");
        e2.display();

        sc.close();
    }
}


// ==================================================
// Q5. PAYMENT INTERFACE WITH pay() - UPI AND CARD PAYMENT
// File: PaymentDemo.java
// ==================================================
import java.util.Scanner;

interface Payment
{
    void pay(double amount);
}

class UpiPayment implements Payment
{
    String upiId;

    UpiPayment(String upiId)
    {
        this.upiId = upiId;
    }

    public void pay(double amount)
    {
        System.out.println("Paid Rs." + amount + " using UPI ID: " + upiId);
    }
}

class CardPayment implements Payment
{
    String cardNumber;

    CardPayment(String cardNumber)
    {
        this.cardNumber = cardNumber;
    }

    public void pay(double amount)
    {
        System.out.println("Paid Rs." + amount + " using Card: " + cardNumber);
    }
}

public class PaymentDemo
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        System.out.println("1. UPI Payment  2. Card Payment");
        System.out.print("Enter your choice: ");
        int choice = Integer.parseInt(sc.nextLine().trim());

        System.out.print("Enter amount: ");
        double amount = Double.parseDouble(sc.nextLine().trim());

        Payment p;
        if (choice == 1)
        {
            System.out.print("Enter UPI ID: ");
            p = new UpiPayment(sc.nextLine());
            p.pay(amount);
        }
        else if (choice == 2)
        {
            System.out.print("Enter card number: ");
            p = new CardPayment(sc.nextLine());
            p.pay(amount);
        }
        else
        {
            System.out.println("Invalid choice");
        }

        sc.close();
    }
}




